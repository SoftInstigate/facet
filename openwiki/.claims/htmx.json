  "claims": [
    {
      "id": "claim_21ffad39cca34fa880f8ac050f37a0f8",
      "statement": "HtmxRequestDetector.isHtmxRequest() classifies a request as HTMX only when the HX-Request header is present and the Accept header contains \"*/*\", and HtmlResponseHelper.acceptsHtml() treats a request as HTML-capable when either Accept contains text/html or this HTMX check passes.",
      "evidence": [
        {
          "resource": "repo://core/src/main/java/org/facet/html/internal/HtmlResponseHelper.java#L39-L51",
          "version": "repo-lines-v1:sha256:1f5db453e58eff8905a093205e1382a6d0fc7eb1a7d464d4e25b73030803a845:"
        },
        {
          "resource": "repo://core/src/main/java/org/facet/html/internal/HtmxRequestDetector.java#L49-L68",
          "version": "repo-lines-v1:sha256:2a081cfad1849d0cd039d938d61315602d550d5a593243e6034195750b46c922:"
        }
      ]
    },
    {
      "id": "claim_4ed5798de7ff41c492d2da1328660f8f",
      "statement": "PathBasedTemplateResolver.resolveFragment() strips the leading '#' from the HX-Target value implicitly by requiring callers to pass a bare target id, and resolves fragments by trying only two candidates without walking the path hierarchy: templates/<path>/_fragments/<targetId>.html then templates/_fragments/<targetId>.html; a blank target id returns empty immediately.",
      "evidence": [
        {
          "resource": "repo://core/src/main/java/org/facet/templates/PathBasedTemplateResolver.java#L221-L253",
          "version": "repo-lines-v1:sha256:e11aa33723a7a0b3c6152000231c4c121e49fa09c0f1175088bbca7ee2371e07:"
        },
        {
          "resource": "repo://core/src/main/java/org/facet/templates/PathBasedTemplateResolver.java#L265-L300",
          "version": "repo-lines-v1:sha256:a3996274dbf467c41f96c4e78d4dc405b70570a1237e8bea9773b5fb66349e8c:"
        }
      ]
    },
    {
      "id": "claim_ec4bc9b0d02d42e0ae7b2a5c2b99be49",
      "statement": "Fragment resolution operates in strict mode: when neither the resource-specific nor the root fallback fragment template exists, resolution returns empty and callers surface a 500 error instead of falling back to a full-page template.",
      "evidence": [
        {
          "resource": "repo://core/src/main/java/org/facet/templates/PathBasedTemplateResolver.java#L244-L253",
          "version": "repo-lines-v1:sha256:6b79ff1f5c8369b179b26e91c58b1ae6706354db1c312b1d66af35fd61455a8f:"
        },
        {
          "resource": "repo://core/src/main/java/org/facet/templates/PathBasedTemplateResolver.java#L56-L71",
          "version": "repo-lines-v1:sha256:eec6b084f98e5756237620b3e3e9aec1731dcbbc68d8386b0172588c9086400d:"
        }
      ]
    },
    {
      "id": "claim_54058497c18a4e34ae23b6f8c4e5b02c",
      "statement": "HtmxResponseHelper provides static helper methods that set HTMX response headers (HX-Trigger and its After-Swap/After-Settle variants, HX-Retarget, HX-Reswap, HX-Push-Url, HX-Replace-Url, HX-Redirect, HX-Refresh) for use from custom services or interceptors.",
      "evidence": [
        {
          "resource": "repo://core/src/main/java/org/facet/html/internal/HtmxResponseHelper.java#L47-L216",
          "version": "repo-lines-v1:sha256:781c6fad1c1ac4530466fefa9cb63d7ec7f0416640ebe04b65b1e0b409c529ab:"
        }
      ]
    },
    {
      "id": "claim_44fe6e1968654f028450fd94724452a1",
      "statement": "HtmlAuthRedirectInterceptor runs at REQUEST_AFTER_FAILED_AUTH and, for HTMX requests, sends the login URL via an HX-Redirect response header while keeping the HTTP status at 401, instead of issuing a 302 Location redirect as it does for non-HTMX browser requests; this prevents HTMX from swapping the login page into the original fragment target.",
      "evidence": [
        {
          "resource": "repo://core/src/main/java/org/facet/html/HtmlAuthRedirectInterceptor.java#L157-L185",
          "version": "repo-lines-v1:sha256:0d6d6aecd4a08e615b958ea4305ca19d32978176513fa0da7f68138634fb887a:"
        }
      ]
    },
    {
      "id": "claim_a28c5d5f4ef34e0f83f1676e202d219e",
      "statement": "For HTMX requests, HtmlAuthRedirectInterceptor derives the auth-failure redirect target from the HX-Current-URL request header (via localPathOf()) rather than from the failing request's own path, because that path is typically a fragment or action endpoint (e.g. a PATCH to a document URL) and not a navigable page; it falls back to the raw request path if HX-Current-URL is absent or unparsable.",
      "evidence": [
        {
          "resource": "repo://core/src/main/java/org/facet/html/HtmlAuthRedirectInterceptor.java#L160-L171",
          "version": "repo-lines-v1:sha256:baeccdb15c2e108ae21694ae858e476f7110183e0243a37f75db9acf73b95c41:"
        },
        {
          "resource": "repo://core/src/main/java/org/facet/html/HtmlAuthRedirectInterceptor.java#L235-L258",
          "version": "repo-lines-v1:sha256:0f6039ec8bd5d6ec0e02bb705b93afe9e21e6b9c8dcf75f19db738b0848de54a:"
        }
      ]
    },
    {
      "id": "claim_86869e8687bf4fd0a7e1614a658cb0aa",
      "statement": "HtmlAuthRedirectInterceptor.resolve() only acts on unauthenticated requests that accept HTML (not request.isAuthenticated() && acceptsHtml(...)), so authenticated-but-unauthorized (403) requests are left untouched and keep their auth cookie and original response.",
      "evidence": [
        {
          "resource": "repo://core/src/main/java/org/facet/html/HtmlAuthRedirectInterceptor.java#L260-L266",
          "version": "repo-lines-v1:sha256:f22ba53ddc09ba0a713bca25d276fb74ecfd955aafe98fb81cb95c4420b3477d:"
        }
      ]
    },
    {
      "id": "claim_6a6d340a84c94ff3be4294e3845b9e2d",
      "statement": "HtmlAuthRedirectInterceptor clears the configured auth cookie and removes the WWW-Authenticate header on every redirect it issues (HTMX or not), to prevent an infinite redirect loop from a stale or expired auth token, and supports an exclude-paths configuration that bypasses the interceptor entirely for matching path prefixes.",
      "evidence": [
        {
          "resource": "repo://core/src/main/java/org/facet/html/HtmlAuthRedirectInterceptor.java#L144-L193",
          "version": "repo-lines-v1:sha256:c9c685f40b35adb8e50e081418278bc5451710e4f1a776b934b6a4806ec9432e:"
        }
      ]
    },
    {
      "id": "claim_10cd7d163b664389a9958fcffcce7086",
      "statement": "HtmlResponseHelper.isEventStreamRequest() detects SSE requests via Accept: text/event-stream, and HtmlResponseInterceptor.resolve() checks this before the general acceptsHtml() check, returning false (bypassing HTML interception) so RESTHeart's SSE infrastructure handles the response unchanged.",
      "evidence": [
        {
          "resource": "repo://core/src/main/java/org/facet/html/HtmlResponseInterceptor.java#L280-L291",
          "version": "repo-lines-v1:sha256:87389fffb3dc72a7bcb860562019a74e8e80b5617277bc54c86416509b0b818b:"
        },
        {
