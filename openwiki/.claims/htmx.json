          "version": "repo-lines-v1:sha256:abf8e993573cbee9e86df327e5519975d6ad2518967d2be9b7d0cb42b543c574:"
        }
      ]
    },
    {
      "id": "claim_753a5a9d687c4090b2998546274fcfff",
      "statement": "TemplateContextBuilder always sets the requestMethod template variable from the HTTP request method, making it available in every rendered template (full page or fragment) to support conditional post-mutation feedback.",
