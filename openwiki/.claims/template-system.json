    {
      "id": "claim_2481527f6a6740e78b721bbd7de6377d",
      "statement": "PathBasedTemplateResolver.resolve(processor, path, type) fully exhausts the explicit action-template hierarchy (list.html for COLLECTION/ROOT/DB, view.html for DOCUMENT: exact path, each parent segment, then the global template) before falling back to the equivalent index.html hierarchy; the two hierarchies are not interleaved level-by-level.",
      "evidence": [
        {
          "resource": "repo://core/src/main/java/org/facet/templates/PathBasedTemplateResolver.java#L161-L219",
          "version": "repo-lines-v1:sha256:9c6efee2ac7b5ad9c6ab1154c5d63c18031053cf7e95d551878aedc8471217ba:"
        },
        {
          "resource": "repo://core/src/main/java/org/facet/templates/PathBasedTemplateResolver.java#L255-L324",
          "version": "repo-lines-v1:sha256:a043ca9300207e8d5cfd46cf9b48f540e35b7edbee854bae4768cf99ae531ec2:"
        }
      ]
    },
    {
      "id": "claim_44e6067574c045b88c9ea409b3b15bbb",
      "statement": "PathBasedTemplateResolver.resolveFragment() performs a strict 2-level lookup (resource-specific _fragments/{id}.html, then root _fragments/{id}.html) with no parent-segment hierarchy walk, returning empty Optional (triggering a 500 in strict mode) when neither exists.",
      "evidence": [
        {
          "resource": "repo://core/src/main/java/org/facet/templates/PathBasedTemplateResolver.java#L244-L253",
          "version": "repo-lines-v1:sha256:6b79ff1f5c8369b179b26e91c58b1ae6706354db1c312b1d66af35fd61455a8f:"
        },
        {
