    {
      "id": "claim_fe6e5ed3bf3b42388aeeb9268bd48282",
      "statement": "HtmlAuthRedirectInterceptor only fires for truly unauthenticated (401) requests, not authenticated-but-unauthorized (403) ones. For HTML-capable requests it keeps HTMX requests at 401 but adds an HX-Redirect header whose target is derived from HX-Current-URL (not the fragment/action endpoint request path); non-HTMX requests get a 302 Found whose Location URL-encodes the original raw path+query into the configurable redirect-param (default 'redirect'). Both cases clear a configurable cookie-name cookie (default rh_auth), and exclude-paths still skips the interceptor entirely.",
      "evidence": [
        {
          "resource": "repo://core/src/main/java/org/facet/html/HtmlAuthRedirectInterceptor.java#L116-L215",
          "version": "repo-lines-v1:sha256:26210dfba8ff91f795231cd10fdf1e2a727382495ba3cad476d33e3ab4d95279:"
        }
      ]
    },
    {
      "id": "claim_63b3d79d7d1049daa7d3effe9dbab698",
      "statement": "LoginService is a JsonService that returns a JSON model for GET /login (rendered as HTML by HtmlResponseInterceptor); it supports redirect-param, default-redirect, roles-endpoint, and cookie-name options, guards the redirect query parameter with safeRedirect() (only local absolute paths starting with a single '/' and free of backslash/quote/angle-bracket/backtick/whitespace are honored, otherwise default-redirect is used), and dynamically registers HtmlAuthRedirectInterceptor (forwarding redirect-param and cookie-name) if not already present.",
      "evidence": [
        {
          "resource": "repo://core/src/main/java/org/facet/html/LoginService.java#L88-L222",
          "version": "repo-lines-v1:sha256:0b5aaf48a2f6b713a53b5638bb0146f8fe3048a0569b682ea88e94e5253c7802:"
        }
      ]
    },
