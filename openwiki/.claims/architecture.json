    {
      "id": "claim_c7d91e9e39d44ebb848b0769182b20ac",
      "statement": "HtmlResponseInterceptor.resolve() bypasses SSE (text/event-stream) requests first, then requires acceptsHtml(), then bypasses 401/403, then intercepts any other 4xx/5xx, then (for MongoRequest) treats extra path segments as a 404, and finally for 2xx responses checks template existence via resolveTemplateWithType(), caching the resolved name as the RESOLVED_TEMPLATE exchange attachment reused by handle().",
      "evidence": [
        {
          "resource": "repo://core/src/main/java/org/facet/html/HtmlResponseInterceptor.java#L281-L334",
          "version": "repo-lines-v1:sha256:1d2bc16bea7661e002b52866b9b48ccabd22b3e29c5dfbe8c172d7d62309b2b5:"
        }
      ]
    },
    {
      "id": "claim_6c59893b89b145d9b6ed92fa89de5cd7",
      "statement": "HtmlErrorResponseInterceptor catches errors at REQUEST_AFTER_AUTH phase (before RESPONSE) for any service, such as MongoDB database/collection not found, and delegates to HtmlResponseHelper.renderErrorPage().",
      "evidence": [
        {
          "resource": "repo://core/src/main/java/org/facet/html/HtmlErrorResponseInterceptor.java#L14-L72",
          "version": "repo-lines-v1:sha256:e8ac366893803deb42d861fc20d1045a7cbc4f51b4ce5dd64c45e9223be8f752:"
        }
