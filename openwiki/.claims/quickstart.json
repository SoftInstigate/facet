    {
      "id": "claim_256d81c63773429fbbafc4807e11752a",
      "statement": "Remaining known limitations include: HX-Reselect header not implemented, JsonHtmlResponseHandler loads full response into memory, MongoDB timeout handling not configurable, and thread pool size not configurable for the Pebble processor. The MongoDB count cache is no longer a plain hardcoded-TTL map: it is a bounded Caffeine cache (5-second TTL, 1000-entry max size) keyed by filter JSON, though the TTL/size are still compile-time constants rather than runtime-configurable.",
      "evidence": [
        {
          "resource": "repo://CHANGELOG.md#L191-L199",
          "version": "repo-lines-v1:sha256:ff6e73a101577cec85da790dfe7857ec21d7f7f9d55cbf675142efdcdb57ba43:"
        },
