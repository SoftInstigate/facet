    {
      "id": "claim_de8a1b2ce5f945e5a70fc0fa44615a5f",
      "statement": "The product-stats.mjs JavaScript service (examples/product-catalog/plugins/product-stats/product-stats.mjs) is a RESTHeart service registered at /shop/stats that iterates the shop.products MongoDB collection via the mclient global and BsonDocument interop, computing total/inStock/outOfStock/avgPrice/min-max price/per-category/low-stock statistics and returning them as JSON for consumption by both API clients and the templates/shop/stats/index.html Facet template.",
